{% extends "@SurvosTabler/layout/base.html.twig" %}

{% block title %}Movie (api-grid + Meilisearch provider){% endblock %}

{% block body %}
    <div class="alert alert-info">
        Same <code>&lt;twig:api_grid&gt;</code> component as
        <a href="{{ path('survos_admin_browse', {code: 'app_movie'}) }}">the Doctrine-backed browse page</a> --
        only the <code>apiGetCollectionUrl</code> differs. It points at
        <code>{{ path('_api_/meilisearch/movies_get_collection') }}</code>, a <code>GetCollection</code>
        operation served by <code>ApiPlatform\Meilisearch\State\CollectionProvider</code>
        (<a href="https://github.com/api-platform/core/pull/8443" target="_blank" rel="noopener">PR #8443</a>),
        not Doctrine ORM. api-grid itself has no idea the difference -- it just calls a GetCollection IRI.
    </div>

    <twig:api_grid
        :class="class"
        :entityClass="class"
        :apiGetCollectionUrl="path('_api_/meilisearch/movies_get_collection')"
        :columnControl="true"
        :searchBuilder="false"
        :select="true"
        :scrollX="true"
    />
{% endblock %}
