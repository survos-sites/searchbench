{% set movie = record|default(hit.data) %}
{% set id = attribute(movie, 'id')|default(null) %}
{% set title = attribute(movie, 'title')|default(id ? 'Movie #' ~ id : 'Movie') %}
{% set overview = attribute(movie, 'overview')|default(null) %}
{% set posterUrl = attribute(movie, 'posterUrl')|default(attribute(movie, 'poster_url')|default(null)) %}
{% set year = attribute(movie, 'year')|default(null) %}
{% set rating = attribute(movie, 'rating')|default(null) %}
{% set votes = attribute(movie, 'votes')|default(null) %}
{% set budget = attribute(movie, 'budget')|default(null) %}
{% set director = attribute(movie, 'director')|default(null) %}
{% set genres = attribute(movie, 'genres')|default([]) %}
{% set tags = attribute(movie, 'tags')|default([]) %}

<article class="card h-100 shadow-sm border-0">
    <div class="card-body p-3">
        <div class="d-flex gap-3">
            {% if posterUrl %}
                <div class="flex-shrink-0" style="width:86px;">
                    <img
                        src="{{ posterUrl }}"
                        alt="{{ title }}"
                        class="img-fluid rounded"
                        loading="lazy"
                        decoding="async"
                        style="max-height:128px;object-fit:cover;"
                    >
                </div>
            {% endif %}

            <div class="min-w-0 flex-grow-1">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h2 class="h5 card-title mb-1 text-wrap" style="word-break:break-word;">
                        {{ title }}
                    </h2>
                    {% if year %}
                        <span class="badge bg-primary-subtle text-primary-emphasis">{{ year }}</span>
                    {% endif %}
                </div>

                {% if director %}
                    <div class="small text-body-secondary mb-2">
                        {{ director }}
                    </div>
                {% endif %}

                {% if overview %}
                    <p
                        class="text-body-secondary mb-0"
                        style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;"
                    >
                        {{ overview }}
                    </p>
                {% endif %}
            </div>
        </div>

        {% if genres is iterable and genres|length > 0 %}
            <div class="d-flex flex-wrap gap-1 mt-3">
                {% for genre in genres|slice(0, 4) %}
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ genre }}</span>
                {% endfor %}
                {% if genres|length > 4 %}
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">+{{ genres|length - 4 }}</span>
                {% endif %}
            </div>
        {% endif %}

        {% if tags is iterable and tags|length > 0 %}
            <div class="d-flex flex-wrap gap-1 mt-2">
                {% for tag in tags|slice(0, 3) %}
                    <span class="badge bg-light text-body-secondary">{{ tag }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center flex-wrap gap-2 pt-0">
        <div class="d-flex flex-wrap gap-2 small text-body-secondary">
            {% if rating %}
                <span>Rating: {{ rating }}</span>
            {% endif %}
            {% if votes %}
                <span>Votes: {{ votes|number_format }}</span>
            {% endif %}
            {% if budget %}
                <span>Budget: {{ budget|number_format }}</span>
            {% endif %}
        </div>

        {% if id %}
            <a href="{{ path('admin_movie_detail', {entityId: id}) }}" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                {{ ux_icon('tabler:file-info')|raw }}
                <span>Record</span>
            </a>
        {% endif %}
    </div>
</article>
